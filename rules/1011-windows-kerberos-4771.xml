<!--
======================================================================
Wazuh Security Framework - Windows Authentication

Module:
    Kerberos Authentication

Windows events:
    4771 - Kerberos pre-authentication failed

Custom rule range:
    101100-101199

Version:
    1.0
======================================================================
-->

<group name="windows,windows_security,authentication,kerberos,">

    <!-- ========================================================= -->
    <!-- Base rule: Event ID 4771                                  -->
    <!-- Internal parent rule; does not create an alert itself.     -->
    <!-- ========================================================= -->

    <rule id="101100" level="0">
        <if_sid>60104</if_sid>
        <field name="win.system.eventID">^4771$</field>
        <description>Windows Kerberos pre-authentication failure</description>
    </rule>


    <!-- ========================================================= -->
    <!-- Failure code 0x18: KDC_ERR_PREAUTH_FAILED                  -->
    <!-- Usually an incorrect password or stale credentials.        -->
    <!-- ========================================================= -->

    <rule id="101101" level="5">
        <if_sid>101100</if_sid>
        <field name="win.eventdata.status">^0x18$</field>
        <description>Windows Kerberos authentication failed - invalid password</description>
    </rule>


    <!-- ========================================================= -->
    <!-- Failure code 0x12: KDC_ERR_CLIENT_REVOKED                  -->
    <!-- Typically a locked, disabled, or otherwise revoked account. -->
    <!-- In our verified test, the account was locked.               -->
    <!-- ========================================================= -->

    <rule id="101102" level="7">
        <if_sid>101100</if_sid>
        <field name="win.eventdata.status">^0x12$</field>
        <description>Windows Kerberos authentication failed - account locked or revoked</description>
    </rule>


    <!-- ========================================================= -->
    <!-- Correlation: repeated invalid passwords                    -->
    <!-- Five Event ID 4771 / status 0x18 events within 120 seconds -->
    <!-- for the same user account and the same source IP address.   -->
    <!-- Suppress duplicate correlation alerts for five minutes.    -->
    <!-- ========================================================= -->

<rule id="101110"
      level="10"
      frequency="5"
      timeframe="120"
      ignore="300">

    <if_matched_sid>101101</if_matched_sid>

    <field name="win.eventdata.targetUserName"
           type="pcre2"
           negate="yes">(?i)\$$</field>

    <same_field>win.eventdata.targetUserName</same_field>
    <same_field>win.eventdata.ipAddress</same_field>

    <description>Possible Kerberos password attack - repeated invalid passwords for the same user account from the same source</description>

    <options>alert_by_email</options>

    <mitre>
        <id>T1110</id>
    </mitre>
</rule>

</group>
