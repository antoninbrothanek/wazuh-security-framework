<group name="windows,authentication,ntlm,">

  <!-- ========================================================= -->
  <!-- NTLMv1 authenticated network logon                       -->
  <!-- Event ID 4624 / NTLM V1                                  -->
  <!-- Anonymous logons are intentionally excluded.             -->
  <!-- ========================================================= -->

  <rule id="101300" level="10">
    <if_group>authentication_success</if_group>

    <field name="win.system.eventID">^4624$</field>
    <field name="win.eventdata.logonType">^3$</field>
    <field name="win.eventdata.authenticationPackageName">^NTLM$</field>
    <field name="win.eventdata.lmPackageName">^NTLM V1$</field>
    <field name="win.eventdata.targetUserName" negate="yes">^ANONYMOUS LOGON$</field>

    <description>NTLMv1 authenticated network logon - User: $(win.eventdata.targetDomainName)\$(win.eventdata.targetUserName) - Source: $(win.eventdata.workstationName) ($(win.eventdata.ipAddress))</description>
  </rule>

  <!-- ========================================================= -->
  <!-- NTLM credential validation failures                      -->
  <!-- Event ID 4776                                            -->
  <!-- ========================================================= -->

  <rule id="101310" level="5">
    <if_group>windows_security</if_group>

    <field name="win.system.eventID">^4776$</field>
    <field name="win.eventdata.packageName">^MICROSOFT_AUTHENTICATION_PACKAGE_V1_0$</field>
    <field name="win.eventdata.status">^0xc000006a$</field>

    <description>NTLM credential validation failed - wrong password - User: $(win.eventdata.targetUserName) - Workstation: $(win.eventdata.workstation)</description>
  </rule>

  <rule id="101311" level="5">
    <if_group>windows_security</if_group>

    <field name="win.system.eventID">^4776$</field>
    <field name="win.eventdata.packageName">^MICROSOFT_AUTHENTICATION_PACKAGE_V1_0$</field>
    <field name="win.eventdata.status">^0xc0000064$</field>

    <description>NTLM credential validation failed - unknown account - User: $(win.eventdata.targetUserName) - Workstation: $(win.eventdata.workstation)</description>
  </rule>

  <!-- ========================================================= -->
  <!-- Correlation: repeated NTLM invalid passwords              -->
  <!-- Five Event ID 4776 / status 0xc000006a events within     -->
  <!-- 120 seconds for the same user account and workstation.    -->
  <!-- Machine accounts are excluded.                            -->
  <!-- Suppress duplicate correlation alerts for five minutes.   -->
  <!-- ========================================================= -->

  <rule id="101320"
        level="10"
        frequency="5"
        timeframe="120"
        ignore="300">

    <if_matched_sid>101310</if_matched_sid>

    <field name="win.eventdata.targetUserName"
           type="pcre2"
           negate="yes">(?i)\$$</field>

    <same_field>win.eventdata.targetUserName</same_field>
    <same_field>win.eventdata.workstation</same_field>

    <description>Possible NTLM password attack - repeated invalid passwords for the same user account from the same workstation</description>

    <options>alert_by_email</options>

    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

</group>
