<group name="windows,windows_security,account_management,">

  <rule id="102000" level="8">
    <if_sid>60109</if_sid>

    <field name="win.system.eventID">^4720$</field>

    <description>Windows user account created: $(win.eventdata.targetUserName) by $(win.eventdata.subjectUserName)</description>

    <options>alert_by_email</options>

    <group>user_created,administrative_change,operational_action_required,</group>
  </rule>
  
  <rule id="102001" level="8">
  <if_sid>60109</if_sid>
  <field name="win.system.eventID">^4722$</field>

  <description>Windows user account enabled: $(win.eventdata.targetUserName) by $(win.eventdata.subjectUserName)</description>

  <options>alert_by_email</options>
<group>user_enabled,administrative_change,operational_action_required,</group>
</rule>

<rule id="102004" level="8">
  <if_sid>60111</if_sid>
  <field name="win.system.eventID">^4725$</field>

  <description>Windows user account disabled: $(win.eventdata.targetUserName) by $(win.eventdata.subjectUserName)</description>

  <options>alert_by_email</options>

  <group>user_disabled,administrative_change,operational_action_required,</group>
</rule>

<rule id="102005" level="10">
  <if_sid>60111</if_sid>
  <field name="win.system.eventID">^4726$</field>

  <description>Windows user account deleted: $(win.eventdata.targetUserName) by $(win.eventdata.subjectUserName)</description>

  <options>alert_by_email</options>

  <group>user_deleted,administrative_change,operational_action_required,</group>
</rule>
<rule id="102006" level="8">
  <if_sid>60110</if_sid>
  <field name="win.system.eventID">^4738$</field>

  <description>Windows user account changed: $(win.eventdata.targetUserName) by $(win.eventdata.subjectUserName)</description>

  <group>user_changed,administrative_change,operational_action_required,</group>
</rule>
</group>
