<group name="windows,windows_security,password_management,">

  <rule id="102100" level="9">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4724$</field>

    <description>Windows user password reset: $(win.eventdata.targetUserName) by $(win.eventdata.subjectUserName)</description>

    <options>alert_by_email</options>

    <group>password_reset,administrative_change,operational_action_required,</group>
  </rule>

</group>
