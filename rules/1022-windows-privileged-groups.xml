<group name="windows,windows_security,privileged_group_management,">

  <!-- Account Operators - ADD only -->
  <rule id="102200" level="12">
    <if_sid>60173</if_sid>
    <field name="win.system.eventID">^4732$</field>

    <description>CRITICAL: Member added to privileged group Account Operators: $(win.eventdata.memberName) by $(win.eventdata.subjectUserName)</description>

    <options>alert_by_email</options>
    <group>privileged_group_change,privilege_escalation,operational_action_required,</group>
  </rule>

  <!-- Server Operators - ADD only -->
