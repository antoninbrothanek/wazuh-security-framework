<group name="windows,windows_security,privilege_escalation,persistence,">

  <!--
    Event ID: 4697
    Windows Security Audit
    A service was installed in the system

    MITRE ATT&CK:
      T1543.003 - Create or Modify System Process: Windows Service

    Prerequisite:
      Advanced Audit Policy ->
      System ->
      Audit Security System Extension = Success
  -->

  <rule id="111000" level="10">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4697$</field>
    <description>Windows service installed by $(win.eventdata.subjectDomainName)\$(win.eventdata.subjectUserName): $(win.eventdata.serviceName)</description>

    <mitre>
      <id>T1543.003</id>
    </mitre>

    <group>
      windows,
      windows_security,
      privilege_escalation,
      persistence,
      service_installation,
    </group>
  </rule>

  <!--
    Event ID: 4964
    Windows Security Audit
    Special groups have been assigned to a new logon

    Prerequisites:
      Advanced Audit Policy ->
      Logon/Logoff ->
      Audit Special Logon = Success

      HKLM\SYSTEM\CurrentControlSet\Control\Lsa\Audit
      SpecialGroups (REG_SZ) contains one or more monitored group SIDs.

    Initial validated configuration:
      S-1-5-32-544 - BUILTIN\Administrators

    Validation state:
      - Event 4964 generation verified on server02;
      - live windows_eventchannel ingestion verified;
      - no active stock Wazuh rule for Event 4964 was found;
      - positive detection for human accounts verified;
      - LocalSystem and computer-account exclusions verified;
      - customer-specific service-account exclusion via CDB list verified in production;
      - email is intentionally not enabled.
  -->

  <!-- Internal base rule for Event ID 4964. -->
  <rule id="111200" level="0">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4964$</field>
    <description>Special groups assigned to a new logon</description>
  </rule>

  <!--
    Alert for privileged logons that are not known infrastructure noise.

    Excludes:
      - LocalSystem;
      - Active Directory computer accounts ending in $;
      - customer-approved service/automation accounts stored in
        etc/lists/wsf-privileged-service-accounts.

    The CDB list is customer-specific. The rule itself remains portable.
  -->
  <rule id="111201" level="10">
    <if_sid>111200</if_sid>

    <field name="win.eventdata.targetUserSid" negate="yes">^S-1-5-18$</field>
    <field name="win.eventdata.targetUserName" type="pcre2" negate="yes">(?i)\$$</field>

    <list field="win.eventdata.targetUserName" lookup="not_match_key">etc/lists/wsf-privileged-service-accounts</list>

    <description>Special-group logon by $(win.eventdata.targetDomainName)\$(win.eventdata.targetUserName): $(win.eventdata.sidList)</description>

    <group>
      windows,
      windows_security,
      privilege_escalation,
      privileged_logon,
      special_groups,
    </group>
  </rule>

  <!--
    Event ID: 1102
    Windows Security Audit
    The Security audit log was cleared

    Stock parent:
      63103 - The audit log was cleared

    MITRE ATT&CK:
      T1070.001 - Indicator Removal: Clear Windows Event Logs

    Validation state:
      - Event 1102 generated with Clear-EventLog;
      - live windows_eventchannel ingestion verified;
      - stock rule 63103 matched at level 5;
      - account identity was decoded under win.logFileCleared.*;
      - custom child rule raises severity to level 12;
      - immediate email notification was verified.
  -->

  <rule id="111400" level="12">
    <if_sid>63103</if_sid>
    <description>Critical: Windows Security audit log was cleared on $(win.system.computer) by $(win.logFileCleared.subjectDomainName)\$(win.logFileCleared.subjectUserName)</description>
    <options>alert_by_email</options>

    <mitre>
      <id>T1070.001</id>
    </mitre>

    <group>
      windows,
      windows_security,
      privilege_escalation,
      defense_evasion,
      logs_cleared,
    </group>
  </rule>

</group>
